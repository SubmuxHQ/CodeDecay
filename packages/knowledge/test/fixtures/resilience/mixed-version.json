{
  "id": "uat-resilience-2-mixed-version",
  "kind": "mixed-version",
  "seed": 2,
  "services": [
    { "serviceId": "producer", "version": "new", "role": "producer" },
    { "serviceId": "consumer", "version": "old", "role": "consumer" }
  ],
  "dependencyEdge": "producer->consumer",
  "fault": { "mode": "malformed-response", "injectionPoint": "producer", "durationMs": 1000 },
  "cells": [
    {
      "id": "new-old",
      "producerVersion": "new",
      "consumerVersion": "old",
      "fault": "malformed-response",
      "selected": true
    },
    {
      "id": "new-new",
      "producerVersion": "new",
      "consumerVersion": "new",
      "fault": "malformed-response",
      "selected": true
    }
  ],
  "oracle": { "requireParseSuccess": true },
  "implementation": { "mode": "incompatible-mixed-version", "canParseNewResponse": false },
  "bounds": {
    "maxRetries": 2,
    "maxRequests": 10,
    "timeoutMs": 5000,
    "maxFaultDurationMs": 5000,
    "targetKind": "fixture-local"
  },
  "cleanup": { "plan": "stop fixture services", "recovered": true }
}
