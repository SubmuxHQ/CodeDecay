{
  "id": "uat-resilience-5-prod-target",
  "kind": "explicit-matrix",
  "seed": 5,
  "services": [
    { "serviceId": "api", "version": "new", "role": "consumer" }
  ],
  "dependencyEdge": "api->dep",
  "fault": { "mode": "timeout", "injectionPoint": "dep", "durationMs": 1000 },
  "cells": [
    {
      "id": "cell",
      "producerVersion": "new",
      "consumerVersion": "new",
      "fault": "timeout",
      "selected": true
    }
  ],
  "oracle": {},
  "implementation": { "mode": "correct-fallback", "recovers": true },
  "bounds": {
    "maxRetries": 2,
    "maxRequests": 5,
    "timeoutMs": 5000,
    "maxFaultDurationMs": 5000,
    "targetKind": "production-like"
  },
  "cleanup": { "plan": "n/a" }
}
